<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_library_loan_wizard_form" model="ir.ui.view">
        <field name="name">library.loan.wizard.form</field>
        <field name="model">library.loan.wizard</field>
        <field name="arch" type="xml">
            <form string="Lend a Book">
                <group>
                    <field name="book_id"/>
                    <field name="member_id"/>
                    <field name="due_date"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_library_loan_wizard" model="ir.actions.act_window">
        <field name="name">Lend a Book</field>
        <field name="res_model">library.loan.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
