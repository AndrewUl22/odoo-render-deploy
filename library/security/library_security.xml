<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_library" model="ir.module.category">
        <field name="name">Library</field>
        <field name="sequence">20</field>
    </record>

    <!-- Odoo 19: category goes through res.groups.privilege now -->
    <record id="privilege_library" model="res.groups.privilege">
        <field name="name">Library Access</field>
        <field name="category_id" ref="module_category_library"/>
    </record>

    <record id="group_library_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_library"/>
    </record>

    <record id="group_library_manager" model="res.groups">
        <field name="name">Librarian</field>
        <field name="privilege_id" ref="privilege_library"/>
        <field name="implied_ids" eval="[(4, ref('group_library_user'))]"/>
    </record>

    <!-- A regular member only sees loans linked to their own user account -->
    <record id="library_loan_rule_own" model="ir.rule">
        <field name="name">Library Loan: member sees own loans only</field>
        <field name="model_id" ref="model_library_loan"/>
        <field name="domain_force">[('member_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_library_user'))]"/>
    </record>

    <!-- A librarian sees every loan, regardless of who it belongs to -->
    <record id="library_loan_rule_all" model="ir.rule">
        <field name="name">Library Loan: librarian sees all loans</field>
        <field name="model_id" ref="model_library_loan"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_library_manager'))]"/>
    </record>

</odoo>
