<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_library_member_list" model="ir.ui.view">
        <field name="name">library.member.list</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <list string="Members">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="user_id" optional="show"/>
                <field name="loan_count"/>
            </list>
        </field>
    </record>

    <record id="view_library_member_form" model="ir.ui.view">
        <field name="name">library.member.form</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <form string="Member">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Full name"/></h1>
                    </div>
                    <group>
                        <field name="email"/>
                        <field name="phone"/>
                        <field name="user_id"/>
                        <field name="loan_count"/>
                    </group>
                    <notebook>
                        <page string="Loans">
                            <field name="loan_ids">
                                <list>
                                    <field name="book_id"/>
                                    <field name="loan_date"/>
                                    <field name="return_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_library_member" model="ir.actions.act_window">
        <field name="name">Members</field>
        <field name="res_model">library.member</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
